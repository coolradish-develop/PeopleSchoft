# ---- PeopleSchoft server ----
PS_PORT=8080
PS_HOST=0.0.0.0
# restart automatically when a file in peopleschoft/ changes (handy while iterating on the UI)
PS_RELOAD=1
# PS_DB_PATH=./data/peopleschoft.db
# Public URL Okta should use to reach this server (e.g. an ngrok / cloudflared tunnel) - shown in the SCIM setup text
PS_PUBLIC_URL=http://localhost:8080

# ---- API auth (PeopleSoft Integration Broker style). Set PS_API_AUTH=off to disable. ----
PS_API_AUTH=basic
PS_API_USER=PS
PS_API_PASSWORD=PS
PS_API_TOKEN=peopleschoft-api-token

# ---- UI sign-on: off (open UI) | header (Okta Access Gateway header-based SSO) ----
PS_UI_AUTH=off
# header OAG injects with the user's Okta login (fallbacks OAM_REMOTE_USER, REMOTE_USER, X-Forwarded-User)
PS_SSO_HEADER=PS_SSO_UID
PS_SSO_EMAIL_HEADER=PS_SSO_EMAIL
PS_SSO_NAME_HEADER=PS_SSO_NAME
PS_SSO_GROUPS_HEADER=PS_SSO_GROUPS
# hardening: a static header OAG adds (value = PS_SSO_SECRET) and/or the gateway's address(es) (comma-separated IPs/CIDRs)
PS_SSO_SECRET_HEADER=PS_SSO_SECRET
PS_SSO_SECRET=
PS_SSO_TRUSTED_PROXIES=
# create a PSOPRDEFN user profile the first time an unknown Okta user arrives (1) or reject them (0)
PS_SSO_AUTOCREATE=1
# Okta groups / PeopleSoft roles allowed to change data; everyone else is read-only
PS_SSO_ADMIN_ROLES=PeopleSoft Administrator,HR Administrator,Okta Administrators
# where "Sign out" sends the browser (OAG's logout endpoint)
PS_SSO_LOGOUT_URL=/oag/logout

# ---- SCIM 2.0 inbound (Okta -> PeopleSoft user profiles) ----
PS_SCIM_TOKEN=peopleschoft-scim-token

# ---- HR as a source (Okta imports from PeopleSoft) ----
# SCIM 1.1/2.0 feed at /hr/scim/v1 and /hr/scim/v2 for the Okta Provisioning Agent (On-Premises Provisioning, Profile Source)
PS_HR_SCIM_AUTH=token
PS_HR_SCIM_TOKEN=peopleschoft-hr-token
PS_HR_SCIM_HEADER=X-HR-Token
# accept PUT pushes from Okta (profile updates -> DTA, active=false -> TER, active=true -> REH); off = strictly read-only master
PS_HR_SCIM_WRITEBACK=0
# SQL mirror for the Okta On-prem Connector for Generic Databases: '' (off) | postgres | mysql | mssql
PS_SQL_EXPORT_DIALECT=
PS_SQL_EXPORT_INTERVAL=30
# PS_SQL_EXPORT_DIR=./data/export
# Okta app instance id of the "On-prem Connector for Generic Databases" app (shown as a link on the HR as a Source page)
OKTA_OPC_APP_ID=
# host name or IP of the mirror database as seen from the Okta agent host (not localhost unless the agents run there)
PS_HR_DB_HOST=
# agent container (docker compose --profile agents): single-use install token from the app's guide, and the agent name
OKTA_INSTALL_TOKEN=
OKTA_AGENT_NAME=peopleschoft-opc

# ---- Okta outbound (PeopleSoft -> Okta) ----
# dryrun | webhook | users | identity-source
OKTA_MODE=dryrun
OKTA_ORG_URL=https://dev-000000.okta.com
OKTA_API_TOKEN=
# identity-source mode: the Custom Identity Source app id (0oa...)
OKTA_IDENTITY_SOURCE_ID=
# webhook mode: e.g. an Okta Workflows API Endpoint invoke URL (+ its client token)
OKTA_WEBHOOK_URL=
OKTA_WEBHOOK_TOKEN=
# users mode: also send hireDate/terminationDate/jobCode/... (define them on the Okta user profile first)
OKTA_CUSTOM_ATTRS=off
# seconds between outbox flushes (0 = flush synchronously after each HR action)
OKTA_SYNC_INTERVAL=10
# create pre-hires in Okta this many days before their start date
OKTA_PREHIRE_DAYS=14
# what a leave of absence does to the Okta user: suspend | none
OKTA_LOA_ACTION=suspend
# password: set a random password on create/rehire so users are ACTIVE at once (demo friendly)
# welcome:  no password; Okta emails the activation link and users stay PROVISIONED until they finish the welcome flow
OKTA_ACTIVATION=password

# ---- branding (shown in the header, page titles and auth realm) ----
PS_BRAND=PeopleSchoft

# ---- demo data ----
PS_EMAIL_DOMAIN=atko.email
PS_COMPANY=GBI
